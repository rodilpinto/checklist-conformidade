@@ -0,0 +1,134 @@
+"""Divisao de normativos em lotes e geracao do checklist lote a lote.
+
+Normativos grandes numa unica chamada fazem o Gemma resumir por conta propria e o Gemini
+gratuito recusar com 503 (ver tests/AVALIACAO_MODELOS.md). Lotes de ~800 tokens de entrada
+mantem a cobertura e cada chamada abaixo do timeout.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from typing import Any, Callable
+
+from lib.llm import JSONParseError, generate_checklist
+
+# Medido no Gemma 4: Portaria 227/2025 = 22.267 caracteres / 5.384 tokens.
+CHARS_POR_TOKEN = 4.1
+LOTE_TOKENS_PADRAO = 800
+
+_CABECALHO = re.compile(r"^\s*(CAP[IÍ]TULO|T[IÍ]TULO|SE[CÇ][AÃ]O|SUBSE[CÇ][AÃ]O|LIVRO|PARTE)\b", re.I)
+_ARTIGO = re.compile(r"^\s*Art(?:igo)?\.?\s*\d+", re.I)
+
+
+def _tokens(texto: str) -> float:
+    return len(texto) / CHARS_POR_TOKEN
+
+
+def _contexto(pendente: str, anterior: str) -> str:
+    """Cabecalho (ex.: 'CAPITULO II') + linha de titulo seguinte, se houver cabecalho no trecho."""
+    linhas = [l.strip() for l in pendente.splitlines() if l.strip()]
+    for i in range(len(linhas) - 1, -1, -1):
+        if _CABECALHO.match(linhas[i]):
+            return " - ".join(linhas[i:i + 2])
+    return anterior
+
+
+def _unidades(texto: str) -> list[tuple[str, str]]:
+    """Quebra o texto em (contexto, trecho): um trecho por artigo, com o cabecalho corrente."""
+    contexto, pendente, unidades, atual = "", "", [], None
+    for linha in texto.splitlines(keepends=True):
+        if _CABECALHO.match(linha):
+            if atual is not None:
+                unidades.append(atual)
+                atual = None
+            pendente += linha
+        elif _ARTIGO.match(linha):
+            if atual is not None:
+                unidades.append(atual)
+            contexto = _contexto(pendente, contexto)
+            atual = (contexto, pendente + linha)
+            pendente = ""
+        elif atual is not None:
+            atual = (atual[0], atual[1] + linha)
+        else:
+            pendente += linha  # preambulo ou titulo do cabecalho
+    if atual is not None:
+        unidades.append(atual)
+    if pendente.strip():
+        if unidades:
+            ctx, t = unidades[-1]
+            unidades[-1] = (ctx, t + pendente)
+        else:
+            unidades.append(("", pendente))
+    return unidades
+
+
+def _por_paragrafos(texto: str, max_tokens: int) -> list[tuple[str, str]]:
+    blocos, atual = [], ""
+    for par in re.split(r"(\n\s*\n)", texto):
+        if atual and _tokens(atual + par) > max_tokens:
+            blocos.append(("", atual))
+            atual = ""
+        atual += par
+    if atual.strip():
+        blocos.append(("", atual))
+    return blocos
+
+
+def dividir_em_lotes(texto: str, max_tokens: int = LOTE_TOKENS_PADRAO) -> list[str]:
+    """Agrupa artigos consecutivos ate ~max_tokens de entrada; cada lote leva o cabecalho corrente."""
+    unidades = _unidades(texto)
+    if len(unidades) <= 1 and _tokens(texto) > max_tokens:
+        unidades = _por_paragrafos(texto, max_tokens)  # normativo sem artigos numerados
+
+    lotes, atual, ctx_lote = [], "", ""
+    for ctx, trecho in unidades:
+        if atual and _tokens(atual + trecho) > max_tokens:
+            lotes.append((ctx_lote, atual))
+            atual = ""
+        if not atual:
+            ctx_lote = ctx
+        atual += trecho
+    if atual.strip():
+        lotes.append((ctx_lote, atual))
+
+    return [
+        (f"[Trecho do normativo. Capitulo/secao em vigor no inicio do trecho: {ctx}]\n\n"
+         if ctx and not _CABECALHO.match(t) else "") + t
+        for ctx, t in lotes
+    ]
+
+
+@dataclass
+class ResultadoLotes:
+    itens: list[dict[str, Any]] = field(default_factory=list)
+    falhas: list[str] = field(default_factory=list)
+    total_lotes: int = 0
+
+
+def gerar_em_lotes(
+    texto: str,
+    llm_config: dict,
+    extra_prompt: str = "",
+    max_tokens: int = LOTE_TOKENS_PADRAO,
+    ao_avancar: Callable[[int, int], None] | None = None,
+    gerar: Callable[..., list[dict[str, Any]]] = generate_checklist,
+) -> ResultadoLotes:
+    """Gera o checklist lote a lote. Um lote que falha nao descarta os demais."""
+    lotes = dividir_em_lotes(texto, max_tokens)
+    res = ResultadoLotes(total_lotes=len(lotes))
+    for i, lote in enumerate(lotes, 1):
+        if ao_avancar:
+            ao_avancar(i, len(lotes))
+        for tentativa in (1, 2):
+            try:
+                res.itens.extend(gerar(lote, extra_prompt=extra_prompt, **llm_config))
+                break
+            except JSONParseError as exc:
+                if tentativa == 2:
+                    res.falhas.append(f"Trecho {i} de {len(lotes)}: {exc}")
+            except Exception as exc:
+                res.falhas.append(f"Trecho {i} de {len(lotes)}: {exc}")
+                break
+    return res

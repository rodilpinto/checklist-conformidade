# ============================================================
# Configuracao do App Gerador de Checklist
# ============================================================
# 1. Copie este arquivo para .env:
#      cp .env.example .env
# 2. Configure o provider de IA que vai usar (Gemini e/ou LLM local).
# 3. NUNCA commite o arquivo .env no repositorio.
# ============================================================

# Nomes e ordem de tentativa: llm_cadeia/README.md ("Segredos"). O Streamlit tambem
# le .streamlit/secrets.toml (do projeto ou ~/.streamlit/) com os mesmos nomes.
# Configure pelo menos um provedor; os demais sao fallback.

# ---- LLM local (servidor OpenAI-compatible, ex.: LM Studio) ----
# So funciona quando o app roda dentro da rede que alcanca este endereco
# (nao funciona no deploy publico do Streamlit Cloud).
LLM_BASE_URL=http://<ip-do-servidor>:1234/v1
LLM_MODEL=google/gemma-4

# ---- Google Gemini (nuvem) ----
# Obtenha em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-chave-aqui
# GEMINI_API_KEY_2=   (outro projeto Google: soma cota)
# Opcional: lista de modelos, separados por virgula (padrao em llm_cadeia/nucleo.py)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# ---- Outros provedores gratuitos (opcionais) ----
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=

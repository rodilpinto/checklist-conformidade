# ============================================================
# Configuracao do App Gerador de Checklist
# ============================================================
# 1. Copie este arquivo para .env:
#      cp .env.example .env
# 2. Configure o provider de IA que vai usar (Gemini e/ou LLM local).
# 3. NUNCA commite o arquivo .env no repositorio.
# ============================================================

# ---- Opcao 1: Google Gemini (nuvem) ----
# Obtenha em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-chave-aqui
# Opcional; padrao gemini-3.6-flash (o gemini-2.5-flash nao aceita mais contas novas)
GEMINI_MODEL=gemini-3.6-flash

# ---- Opcao 2: LLM local (servidor OpenAI-compatible, ex.: LM Studio) ----
# So funciona quando o app roda dentro da rede que alcanca este endereco
# (nao funciona no deploy publico do Streamlit Cloud).
LOCAL_LLM_URL=http://<ip-do-servidor>:1234/v1
LOCAL_LLM_MODEL=google/gemma-4
